# ─────────────────────────────────────────────────────────────
# Copy this file to .env and fill in your keys.
# .env is gitignored — never commit real keys.
# ─────────────────────────────────────────────────────────────

# ── Groq (free cloud LLM) ────────────────────────────────────
# Get free key at: https://console.groq.com
GROQ_API_KEY=gsk_your_key_here

# Model options (all free on Groq):
#   llama-3.3-70b-versatile   ← best quality  (recommended)
#   llama-3.1-8b-instant      ← fastest
#   gemma2-9b-it              ← good alternative
LLM_MODEL=llama-3.3-70b-versatile

# ── Zerodha Kite Connect (market data + order placement) ─────
# Register app at: https://developers.kite.trade/apps
# API key + secret milega wahan se
KITE_API_KEY=your_kite_api_key
KITE_API_SECRET=your_kite_api_secret

# Access token — har roz generate karna padta hai (session-based)
# See: trading_system/data/kite_login.py  for helper script
KITE_ACCESS_TOKEN=your_daily_access_token

# ── How Kite data works ───────────────────────────────────────
# Symbols: plain NSE format — "RELIANCE", "TCS", "INFY"
# (NOT "RELIANCE.NS" — that's only for yfinance)
#
# If KITE_API_KEY + KITE_ACCESS_TOKEN are set → Kite used automatically
# If NOT set → yfinance used as fallback (no key needed)
# ─────────────────────────────────────────────────────────────
