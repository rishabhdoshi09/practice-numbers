# ─────────────────────────────────────────────────────────────
# Copy this file to .env and fill in your keys.
# .env is gitignored — never commit real keys.
# ─────────────────────────────────────────────────────────────

# ── Groq (free cloud LLM) ────────────────────────────────────
# Get free key at: https://console.groq.com
GROQ_API_KEY=gsk_your_key_here

# Model options (all free on Groq):
#   llama-3.3-70b-versatile   ← best quality  (recommended)
#   llama-3.1-8b-instant      ← fastest
#   gemma2-9b-it              ← good alternative
LLM_MODEL=llama-3.3-70b-versatile

# ── Zerodha Kite Connect (market data + order placement) ─────
# Register app at: https://developers.kite.trade/apps
KITE_API_KEY=your_kite_api_key
KITE_API_SECRET=your_kite_api_secret
# Access token — har roz generate karna padta hai
# Run: python -m trading_system.data.kite_login
KITE_ACCESS_TOKEN=your_daily_access_token

# ── News Sources (priority order — top = best) ───────────────

# 1. NewsData.io — BEST for India (200 free credits/day, no card)
#    Get key at: https://newsdata.io  → Free signup
NEWSDATA_API_KEY=your_newsdata_key

# 2. NewsAPI.org — Global + India (1000 calls/month free)
#    Get key at: https://newsapi.org  → Free signup
NEWSAPI_KEY=your_newsapi_key

# 3. RSS feeds (Economic Times, Moneycontrol, Mint)
#    NO KEY NEEDED — works automatically as fallback

# 4. yfinance — final fallback, NO KEY NEEDED

# ── How news source selection works ──────────────────────────
# NEWSDATA_API_KEY set?  → newsdata.io used  (best)
# NEWSAPI_KEY set?       → newsapi.org used
# Neither set?           → RSS feeds tried   (free, no key)
# RSS fails?             → yfinance fallback (always works)
# ─────────────────────────────────────────────────────────────
