# ── Mac setup for TradingAgents ──────────────────────────────
# Copy to .env:  cp .env.mac .env
# Then fill in your keys below.

# GROQ — free LLM (https://console.groq.com)
GROQ_API_KEY=gsk_your_key_here

# KITE — market data (https://developers.kite.trade/apps)
KITE_API_KEY=your_api_key_here
KITE_API_SECRET=your_api_secret_here

# Access token — expires daily at midnight IST
# Generate each morning with:
#   python kite_login.py
KITE_ACCESS_TOKEN=
